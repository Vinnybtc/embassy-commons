{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embassy Commons config 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100,
      "pattern": "^[^<>\\u0000-\\u001f\\u007f]+$"
    },
    "countryCode": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "country": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[^<>\\u0000-\\u001f\\u007f]+$"
    },
    "city": {
      "type": "string",
      "minLength": 2,
      "maxLength": 100,
      "pattern": "^[^<>\\u0000-\\u001f\\u007f]+$"
    },
    "language": {
      "enum": [
        "nl",
        "en"
      ]
    },
    "accent": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "mission": {
      "type": "string",
      "minLength": 10,
      "maxLength": 600,
      "pattern": "^[^<>\\u0000-\\u001f\\u007f]+$"
    },
    "status": {
      "const": "draft"
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "countryCode",
    "country",
    "city",
    "language",
    "accent",
    "mission",
    "status"
  ]
}
