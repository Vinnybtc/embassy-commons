{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Embassy Commons registry 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 100
          },
          "countryCode": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "country": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "nl",
              "en"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 3,
            "maxLength": 160
          },
          "city": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "status": {
            "enum": [
              "source",
              "template",
              "draft"
            ]
          },
          "languages": {
            "type": "array",
            "items": {
              "enum": [
                "nl",
                "en"
              ]
            },
            "minItems": 1,
            "maxItems": 2
          },
          "summary": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nl": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "nl",
              "en"
            ]
          },
          "website": {
            "anyOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "url": {
                    "anyOf": [
                      {
                        "type": "string",
                        "format": "uri"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "accessedAt": {
                    "type": "string",
                    "format": "date"
                  },
                  "rights": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 2000
                  }
                },
                "required": [
                  "url",
                  "accessedAt",
                  "rights"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "coordinates": {
            "anyOf": [
              {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "countryCode",
          "country",
          "name",
          "city",
          "status",
          "languages",
          "summary",
          "website",
          "source",
          "coordinates"
        ]
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "schemaVersion",
    "updatedAt",
    "chapters"
  ],
  "description": "Additional validator relations: unique ids and languages; source records require website and source URL; template records have no real website; draft records have no source and may omit coordinates through null. Coordinates are approximate city centres, not premises."
}
